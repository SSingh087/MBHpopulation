log = LOG_FILES/train_SNR.$(num_neurons)_$(layers).log
error = ERROR_FILES/train_SNR.$(num_neurons)_$(layers).err
output = OUTPUT_FILES/train_SNR.$(num_neurons)_$(layers).out


executable = EXECUTABLES/train_SNR.sh
getenv = True

request_GPUs = 1
request_cpus = 1
request_memory = 2GB

arguments = $(num_neurons) $(layers)

queue num_neurons, layers from (
128 12
)
