## LIST OF JOBS ##

JOB INJECT_PARAMS SUBMIT_FILES/gen_inject_params.sub

JOB GEN_PSD SUBMIT_FILES/gen_PSD.sub

JOB SNR_T_gt_T_obs SUBMIT_FILES/SNR_T_gt_T_obs.sub

JOB SNR_T_lt_T_obs SUBMIT_FILES/SNR_T_lt_T_obs.sub

JOB PREPROCESS_DATA SUBMIT_FILES/preprocess_DATA.sub

JOB TRAIN_SNR SUBMIT_FILES/train_SNR.sub

JOB TRAIN_p0 SUBMIT_FILES/train_p0.sub

## WORKFLOW ##

PARENT INJECT_PARAMS CHILD GEN_PSD

PARENT GEN_PSD CHILD SNR_T_gt_T_obs

PARENT GEN_PSD CHILD SNR_T_lt_T_obs

PARENT SNR_T_lt_T_obs CHILD PREPROCESS_DATA
PARENT SNR_T_gt_T_obs CHILD PREPROCESS_DATA


PARENT PREPROCESS_DATA CHILD TRAIN_SNR
PARENT PREPROCESS_DATA CHILD TRAIN_p0


# # # # # # # # # # # # # # # # # # # # # # 
## ABORT RULES (Stops DAG on failure) ##
# # # # # # # # # # # # # # # # # # # # # # 

RETRY INJECT_PARAMS 1
RETRY GEN_PSD 1
RETRY SNR_T_gt_T_obs 1
RETRY SNR_T_lt_T_obs 1
RETRY PREPROCESS_DATA 1
