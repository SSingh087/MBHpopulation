executable = ./EXECUTABLES/fish_TDE.sh
getenv     = True

arguments  = $(survey) $(start_idx) $(end_idx) $(batch_id)

request_cpus   = 1
request_memory = 4GB

log    = LOG_FILES/fisher_TDE_batch_$(batch_id)_$(survey).log
output = ERROR_FILES/fisher_TDE_batch_$(batch_id)_$(survey).out
error  = OUTPUT_FILES/fisher_TDE_batch_$(batch_id)_$(survey).err

queue