# Executable and arguments
executable      = ./EXECUTABLES/report_universes.sh
getenv          = true
arguments       = $(N_UNIVERSES)
# Logs
log             = LOG_FILES/report_universes_$(N_UNIVERSES).log
error           = ERROR_FILES/report_universes_$(N_UNIVERSES).err
output          = OUTPUT_FILES/report_universes_$(N_UNIVERSES).out
# Notifications
# Resources
request_cpus    = 1
request_memory  = 4GB
queue 1