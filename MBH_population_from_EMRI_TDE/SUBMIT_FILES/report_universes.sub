# Executable and arguments
executable      = ./EXECUTABLES/report_universes.sh
getenv          = true
arguments       = $(N_UNIVERSES) $(MERGER_MODELS)
# Logs
log             = LOG_FILES/report_universes_$(N_UNIVERSES)_$(MERGER_MODELS).log
error           = ERROR_FILES/report_universes_$(N_UNIVERSES)_$(MERGER_MODELS).err
output          = OUTPUT_FILES/report_universes_$(N_UNIVERSES)_$(MERGER_MODELS).out
# Resources
request_cpus    = 1
request_memory  = 4GB
queue 1