
# Executable and arguments
executable      = ./EXECUTABLES/prepare_TDE_SNRs.sh
getenv          = true
arguments       = $(UNIVERSE_MODEL) $(SURVEY) $(MBH_MASS_METHODS) $(NUCLEATION_METHODS)

# Logs
log             = LOG_FILES/prepare_TDE_SNRs_$(UNIVERSE_MODEL)_$(SURVEY)_$(MBH_MASS_METHODS)_$(NUCLEATION_METHODS).log 
error           = ERROR_FILES/prepare_TDE_SNRs_$(UNIVERSE_MODEL)_$(SURVEY)_$(MBH_MASS_METHODS)_$(NUCLEATION_METHODS).err
output          = OUTPUT_FILES/prepare_TDE_SNRs_$(UNIVERSE_MODEL)_$(SURVEY)_$(MBH_MASS_METHODS)_$(NUCLEATION_METHODS).out

# Notifications

# Resources
request_cpus    = 8
request_memory  = 16GB

queue 1
