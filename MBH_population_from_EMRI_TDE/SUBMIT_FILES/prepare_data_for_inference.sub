
# Executable and arguments
executable      = ./EXECUTABLES/prepare_data_for_inference.sh
getenv          = true
arguments       = $(TDE_MODEL) $(BEST_UNIVERSE) $(MBH_MASS_METHODS) $(NUCLEATION_METHODS) $(OCCUPATION_METHODS) $(MERGER_MODELS)

# Logs
log             = LOG_FILES/prepare_data_for_inference_$(TDE_MODEL)_$(MBH_MASS_METHODS)_$(NUCLEATION_METHODS)_$(OCCUPATION_METHODS).log
error           = ERROR_FILES/prepare_data_for_inference_$(TDE_MODEL)_$(MBH_MASS_METHODS)_$(NUCLEATION_METHODS)_$(OCCUPATION_METHODS).err
output          = OUTPUT_FILES/prepare_data_for_inference_$(TDE_MODEL)_$(MBH_MASS_METHODS)_$(NUCLEATION_METHODS)_$(OCCUPATION_METHODS).out


# Resources
request_cpus    = 1
request_memory  = 8GB

queue 1
