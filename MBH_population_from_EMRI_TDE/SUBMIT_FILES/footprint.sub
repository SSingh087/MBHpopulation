# Executable and arguments
executable      = ./EXECUTABLES/footprint.sh
getenv          = true
arguments       = $(UNIVERSE_MODEL) $(MBH_MASS_METHODS) $(NUCLEATION_METHODS) $(OCCUPATION_METHODS) $(TDE_MODEL) $(MERGER_MODELS)

# Logs
log             = LOG_FILES/footprint_$(UNIVERSE_MODEL)_$(MBH_MASS_METHODS)_$(NUCLEATION_METHODS)_$(OCCUPATION_METHODS)_$(TDE_MODEL)_$(MERGER_MODELS).log
error           = ERROR_FILES/footprint_$(UNIVERSE_MODEL)_$(MBH_MASS_METHODS)_$(NUCLEATION_METHODS)_$(OCCUPATION_METHODS)_$(TDE_MODEL)_$(MERGER_MODELS).err
output          = OUTPUT_FILES/footprint_$(UNIVERSE_MODEL)_$(MBH_MASS_METHODS)_$(NUCLEATION_METHODS)_$(OCCUPATION_METHODS)_$(TDE_MODEL)_$(MERGER_MODELS).out


# Resources
request_cpus    = 1
request_memory  = 4GB

queue 1
