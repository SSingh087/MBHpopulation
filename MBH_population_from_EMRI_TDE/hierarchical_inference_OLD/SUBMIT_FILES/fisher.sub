
# Executable and arguments
executable      = ./EXECUTABLES/fisher_$(SOURCE).sh
getenv          = true
arguments       = $(EVENTS)
# Logs
log             = LOG_FILES/fisher_$(SOURCE)_$(EVENTS).log
error           = ERROR_FILES/fisher_$(SOURCE)_$(EVENTS).err
output          = OUTPUT_FILES/fisher_$(SOURCE)_$(EVENTS).out

# Notifications

# Resources
request_cpus    = 1
request_memory  = 1GB
# request_gpus  = 1
# requirements  = (DeviceName == "Tesla V100-PCIE-32GB" || DeviceName == "NVIDIA GeForce RTX 2080 Ti") && (GlobalMemoryMb > 2000)

queue SOURCE in (
    EMRI
    TDE
)