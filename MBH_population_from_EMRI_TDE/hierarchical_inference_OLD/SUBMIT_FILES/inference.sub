
# Executable and arguments
executable      = ./EXECUTABLES/inference.sh
getenv          = true
arguments       = $(EVENTS) $(SOURCE)

# Logs
log             = LOG_FILES/inference_$(SOURCE)_$(EVENTS).log
error           = ERROR_FILES/inference_$(SOURCE)_$(EVENTS).err
output          = OUTPUT_FILES/inference_$(SOURCE)_$(EVENTS).out

# Notifications

# Resources
request_cpus    = 1
request_memory  = 2GB

queue SOURCE in (
    EMRI
    TDE
    EMRI_TDE
)