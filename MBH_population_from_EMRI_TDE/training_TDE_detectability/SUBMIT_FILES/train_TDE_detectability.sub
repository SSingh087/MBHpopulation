log = LOG_FILES/train_TDE.$(num_neurons)_$(layers)_$(loss_type)_$(rescaler_flag)_$(SURVEY)_$(MODEL).log
error = ERROR_FILES/train_TDE.$(num_neurons)_$(layers)_$(loss_type)_$(rescaler_flag)_$(SURVEY)_$(MODEL).err
output = OUTPUT_FILES/train_TDE.$(num_neurons)_$(layers)_$(loss_type)_$(rescaler_flag)_$(SURVEY)_$(MODEL).out


executable = EXECUTABLES/train_TDE_detectability.sh
getenv = True

request_GPUs = 1
request_cpus = 1
request_memory = 12GB

arguments = $(num_neurons) $(layers) $(loss_type) $(rescaler_flag) $(SURVEY) $(MODEL)

# Smart hyperparameter combinations for binary TDE detectability classification,
# now trained as one independent classifier PER redback TDE model (each model
# has its own physics/parameter set, so a single shared network is not
# appropriate -- see gen_TDE_params.py for the per-model parameter spec).
# Testing: neurons (64,128,256,512) x layers (2,3,4) x loss (BCE) x rescaler (no) x surveys (ZTF,LSST) x model (6)
