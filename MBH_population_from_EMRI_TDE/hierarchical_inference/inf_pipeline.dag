# ============= MAKE DATA (one per population x scenario) =========
# make_pseudo_data.py's output filenames are population+scenario
# specific (true_data_EMRI_pseudo_data_{POP}_{mbh}_{nuc}.h5)
JOB make_pseudo_data_A_use_lgMgal_hannah ./pseudo_runs/make_pseudo_data.sub
VARS make_pseudo_data_A_use_lgMgal_hannah POPULATION="A" MBH_MASS_METHODS="use_lgMgal" NUCLEATION_METHODS="hannah" INCLUDE_LSST="1"
JOB make_pseudo_data_A_use_sigma_hannah ./pseudo_runs/make_pseudo_data.sub
VARS make_pseudo_data_A_use_sigma_hannah POPULATION="A" MBH_MASS_METHODS="use_sigma" NUCLEATION_METHODS="hannah" INCLUDE_LSST="1"
JOB make_pseudo_data_A_use_lgMgal_neumayer ./pseudo_runs/make_pseudo_data.sub
VARS make_pseudo_data_A_use_lgMgal_neumayer POPULATION="A" MBH_MASS_METHODS="use_lgMgal" NUCLEATION_METHODS="neumayer" INCLUDE_LSST="1"
JOB make_pseudo_data_A_use_sigma_neumayer ./pseudo_runs/make_pseudo_data.sub
VARS make_pseudo_data_A_use_sigma_neumayer POPULATION="A" MBH_MASS_METHODS="use_sigma" NUCLEATION_METHODS="neumayer" INCLUDE_LSST="1"
JOB make_pseudo_data_B_use_lgMgal_hannah ./pseudo_runs/make_pseudo_data.sub
VARS make_pseudo_data_B_use_lgMgal_hannah POPULATION="B" MBH_MASS_METHODS="use_lgMgal" NUCLEATION_METHODS="hannah" INCLUDE_LSST="1"
JOB make_pseudo_data_B_use_sigma_hannah ./pseudo_runs/make_pseudo_data.sub
VARS make_pseudo_data_B_use_sigma_hannah POPULATION="B" MBH_MASS_METHODS="use_sigma" NUCLEATION_METHODS="hannah" INCLUDE_LSST="1"
JOB make_pseudo_data_B_use_lgMgal_neumayer ./pseudo_runs/make_pseudo_data.sub
VARS make_pseudo_data_B_use_lgMgal_neumayer POPULATION="B" MBH_MASS_METHODS="use_lgMgal" NUCLEATION_METHODS="neumayer" INCLUDE_LSST="1"
JOB make_pseudo_data_B_use_sigma_neumayer ./pseudo_runs/make_pseudo_data.sub
VARS make_pseudo_data_B_use_sigma_neumayer POPULATION="B" MBH_MASS_METHODS="use_sigma" NUCLEATION_METHODS="neumayer" INCLUDE_LSST="1"

