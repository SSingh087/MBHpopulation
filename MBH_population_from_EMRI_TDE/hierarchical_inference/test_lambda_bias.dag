# condor_submit_dag test_lambda_bias.dag   (from an env with numpy/scipy/h5py/matplotlib)
# 32 parallel jobs (pop x 8 scenarios x 2 surveys) -> 1 combine job -> lambda_bias_test/summary_{A,B}.txt + profile_pop{A,B}.png
