
# Executable and arguments
executable      = run_inf_pseudo.sh
getenv          = true
arguments       = $(SOURCE) $(POPULATION) $(SURVEY)

# Logs
log             = run_inference_$(SOURCE)_$(POPULATION)_$(SURVEY).log
error           = run_inference_$(SOURCE)_$(POPULATION)_$(SURVEY).err
output          = run_inference_$(SOURCE)_$(POPULATION)_$(SURVEY).out

# Notifications

# Resources
request_cpus    = 4
request_memory  = 16GB

queue 1
