# Executable and arguments
executable      = ./pseudo_runs/run_inf_pseudo.sh
getenv          = true
arguments       = $(SOURCE) $(POPULATION) $(SURVEY) $(MBH_MASS_METHODS) $(NUCLEATION_METHODS)

# Logs
log             = LOG_FILES/run_inference_$(SOURCE)_$(POPULATION)_$(SURVEY)_$(MBH_MASS_METHODS)_$(NUCLEATION_METHODS).log
error           = ERROR_FILES/run_inference_$(SOURCE)_$(POPULATION)_$(SURVEY)_$(MBH_MASS_METHODS)_$(NUCLEATION_METHODS).err
output          = OUTPUT_FILES/run_inference_$(SOURCE)_$(POPULATION)_$(SURVEY)_$(MBH_MASS_METHODS)_$(NUCLEATION_METHODS).out

# Notifications

# Resources
request_cpus    = 12
request_memory  = 64GB

queue